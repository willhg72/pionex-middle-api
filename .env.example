APP_NAME=Pionex Middle API
APP_VERSION=3.0.0
ENVIRONMENT=dev
DEBUG=false

API_V1_PREFIX=/api/v1
API_KEY_HEADER_NAME=X-API-Key
API_KEYS=["replace-with-secure-api-key"]

# Local default
DATABASE_URL=sqlite+aiosqlite:///./runtime/pionex_middle.db
SQL_ECHO=false

# Railway/InsForge Postgres example:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
