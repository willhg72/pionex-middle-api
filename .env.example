APP_NAME=Pionex Middle API
APP_VERSION=3.0.0
ENVIRONMENT=dev
DEBUG=false

API_V1_PREFIX=/api/v1
API_KEY_HEADER_NAME=X-API-Key
API_KEYS=["replace-with-secure-api-key"]

API_KEY=replace-pionex-api-key
API_SECRET=replace-pionex-api-secret
MINER_CONFIRMATION_SECRET=replace-miner-confirmation-secret

DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
SQL_ECHO=false
AUTO_CREATE_SCHEMA=false

CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
